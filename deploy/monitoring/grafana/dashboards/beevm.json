{
  "uid": "beevm",
  "title": "BeeVM",
  "description": "BeeVM node: call latency (warm / snapshot restore / boot), warm pool, VM density and memory per VM. Optional module (M10).",
  "tags": ["beevm"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row", "title": "Calls", "collapsed": false, "id": 100,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "id": 1, "type": "timeseries", "title": "Calls per second, by how the VM started",
      "description": "warm = reused an idle VM; restore = new VM from a snapshot; boot = full boot; none = no VM (busy or error).",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 25, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (start) (rate(beevm_invocations_total[15s]))", "legendFormat": "{{start}}" }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Warm hit ratio (1 min)",
      "description": "Share of calls that a VM ran which reused an idle VM.",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 0.8 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(beevm_invocations_total{start=\"warm\"}[1m])) / sum(rate(beevm_invocations_total{start!=\"none\"}[1m]))" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Calls (total)",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(beevm_invocations_total)" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Failed calls per second, by status",
      "description": "function_error = the user's function failed (502); busy = no free VM slot (503); error = BeeVM failed (500).",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(beevm_invocations_total{status!=\"ok\"}[15s]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "row", "title": "Latency (cold start target: 50 ms)", "collapsed": false, "id": 101,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "panels": []
    },
    {
      "id": 5, "type": "timeseries", "title": "Call latency inside the server, p50 and p99, by start",
      "description": "Whole /invoke request in beevmd, for calls a VM ran. Log scale: warm calls are ~1 ms, restores ~50-100 ms, boots ~1 s. Red line: 50 ms.",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "scaleDistribution": { "type": "log", "log": 10 }, "thresholdsStyle": { "mode": "line" } },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 0.05 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le, start) (rate(beevm_invoke_duration_seconds_bucket[30s])))", "legendFormat": "p50 {{start}}" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, start) (rate(beevm_invoke_duration_seconds_bucket[30s])))", "legendFormat": "p99 {{start}}" }
      ]
    },
    {
      "id": 6, "type": "bargauge", "title": "New VM until ready over the time range (the cold start)",
      "description": "Starting a VM until its agent answered, for every new VM in the selected time range: restore from a function snapshot (code inside), from a runtime snapshot, or a full boot. New VMs are rare under a warm pool, so this uses the whole range instead of a per-second rate. Green under 50 ms. Values are estimated from histogram buckets.",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "min": 0, "max": 0.2,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.1 } ] } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        { "refId": "A", "instant": true, "range": false, "expr": "histogram_quantile(0.5, sum by (le, start, snapshot) (increase(beevm_vm_ready_seconds_bucket[$__range])))", "legendFormat": "p50 {{start}} {{snapshot}}" },
        { "refId": "B", "instant": true, "range": false, "expr": "histogram_quantile(0.99, sum by (le, start, snapshot) (increase(beevm_vm_ready_seconds_bucket[$__range])))", "legendFormat": "p99 {{start}} {{snapshot}}" }
      ]
    },
    {
      "type": "row", "title": "Density and warm pool", "collapsed": false, "id": 102,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }, "panels": []
    },
    {
      "id": 7, "type": "timeseries", "title": "VMs on this node, by state",
      "description": "Stacked: restoring, idle (warm, waiting for a call), busy, recycling. Dashed: --max-vms.",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "lineInterpolation": "stepAfter" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [
            { "id": "custom.stacking", "value": { "mode": "none" } },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "idle" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "busy" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "restoring" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "recycling" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (state) (beevm_vms)", "legendFormat": "{{state}}" },
        { "refId": "B", "expr": "sum(beevm_vms_max)", "legendFormat": "max" }
      ]
    },
    {
      "id": 8, "type": "stat", "title": "VMs now",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 3, "w": 4, "x": 10, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(beevm_vms)" } ]
    },
    {
      "id": 9, "type": "stat", "title": "Memory per VM (PSS)",
      "description": "Average proportional memory of a VM's Firecracker process: shared snapshot pages are split between the VMs that use them.",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 3, "w": 4, "x": 10, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(beevm_vm_memory_pss_bytes) / sum(beevm_vm_memory_measured_vms)" } ]
    },
    {
      "id": 10, "type": "stat", "title": "Node memory available",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 3, "w": 4, "x": 10, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "beevm_node_memory_available_bytes" } ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Memory per VM: PSS vs RSS",
      "description": "RSS counts shared snapshot pages in every VM; PSS splits them. The gap is memory the VMs share.",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(beevm_vm_memory_pss_bytes) / sum(beevm_vm_memory_measured_vms)", "legendFormat": "PSS per VM" },
        { "refId": "B", "expr": "sum(beevm_vm_memory_rss_bytes) / sum(beevm_vm_memory_measured_vms)", "legendFormat": "RSS per VM" },
        { "refId": "C", "expr": "sum(beevm_vm_memory_pss_bytes)", "legendFormat": "PSS all VMs" }
      ]
    },
    {
      "type": "row", "title": "Lifecycle", "collapsed": false, "id": 103,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 }, "panels": []
    },
    {
      "id": 12, "type": "timeseries", "title": "VMs thrown away per minute, by reason",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (reason) (increase(beevm_vm_recycled_total[1m]))", "legendFormat": "{{reason}}" } ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Calls per second, by function",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (tenant, function, runtime) (rate(beevm_invocations_total[15s]))", "legendFormat": "{{tenant}}/{{function}} ({{runtime}})" } ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Snapshot builds (last 5 min) and build time",
      "datasource": { "type": "prometheus", "uid": "beevm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [
        { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (kind, result) (increase(beevm_snapshot_builds_total[5m]))", "legendFormat": "{{kind}} {{result}}" },
        { "refId": "B", "expr": "sum by (kind) (rate(beevm_snapshot_build_seconds_sum[5m])) / sum by (kind) (rate(beevm_snapshot_build_seconds_count[5m]))", "legendFormat": "avg build time {{kind}}" }
      ]
    }
  ]
}
