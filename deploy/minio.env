# Settings for LOCAL DEVELOPMENT with MinIO. These are throw-away credentials for a server
# that only listens on your own machine; never reuse them anywhere real.
#
# Use:  set -a; source deploy/minio.env; set +a     (then run ./bin/beevmd serve)
#
# For real AWS S3 instead: leave BEEVM_S3_ENDPOINT unset, set BEEVM_S3_BUCKET / BEEVM_S3_REGION,
# and use real AWS credentials (or an IAM role). Nothing else changes.

# MinIO server admin account (also the account BeeVM uses).
MINIO_ROOT_USER=beevmdev
MINIO_ROOT_PASSWORD=beevmdev-secret

# What BeeVM (the AWS SDK) reads:
AWS_ACCESS_KEY_ID=beevmdev
AWS_SECRET_ACCESS_KEY=beevmdev-secret
BEEVM_S3_ENDPOINT=http://127.0.0.1:9000
BEEVM_S3_BUCKET=beevm-artifacts
BEEVM_S3_REGION=us-east-1
